   "source": [
    "# 네이버 영화리뷰 감정 분석 with SentencePiece\n",
    "\n",
    "`ratings_train.txt` 로 학습하고 `ratings_test.txt` 로 평가하는 전체 파이프라인입니다.\n"
    "\n",
    "- 코퍼스: `../ratings_train.txt` (150,000개 / 학습), `../ratings_test.txt` (50,000개 / 테스트)\n",
    "- 실행 위치: 이 문서가 있는 `SentencePiece/` 폴더\n",
    "\n",
    "---\n",
    "\n",
    "## Step 0. 환경 준비"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install sentencepiece torch pandas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ef902506",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import re\n",
    "import sys\n",
    "import glob\n",
    "import time\n",
    "\n",
    "import pandas as pd\n",
    "import sentencepiece as spm\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import TensorDataset, DataLoader\n",
    "from torch.nn.utils.rnn import pad_sequence, pack_padded_sequence\n",
    "\n",
    "BASE_DIR = os.path.dirname(os.path.abspath(__file__)) if '__file__' in globals() else os.getcwd()\n",
    "os.chdir(BASE_DIR)\n",
    "\n",
    "if hasattr(sys.stdout, 'reconfigure'):\n",
    "    sys.stdout.reconfigure(encoding='utf-8')\n",
    "\n",
    "torch.manual_seed(42)   # 토크나이저별 성능을 공정하게 비교하기 위한 시드 고정\n",
    "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "TRAIN_PATH = os.path.join('..', 'ratings_train.txt')   # 데이터는 상위 폴더에 있음\n",
    "TEST_PATH = os.path.join('..', 'ratings_test.txt')\n",
    "\n",
    "MAXLEN = 60          # 문장 최대 토큰 수 (초과분은 잘라냄)\n",
    "BATCH_SIZE = 256\n",
    "EPOCHS = 4           # 실험 5개를 돌리므로 에폭은 짧게 고정\n",
    "\n",
    "print('device:', DEVICE)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7504f305",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Step 1. 코퍼스 분석 및 전처리\n",
    "\n",
    "`id / document / label` 3개 컬럼의 탭 구분 파일입니다. 결측치·중복·정제 후 빈 문장을 제거합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a14add71",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_corpus(path):\n",
    "    \"\"\"NSMC 탭 구분 파일을 읽어 결측치와 중복 리뷰를 제거한 DataFrame 을 반환.\"\"\"\n",
    "    df = pd.read_csv(path, sep='\\t', quoting=3)   # quoting=3 : 따옴표를 문자로 취급\n",
    "    print(f'\\n[{os.path.basename(path)}] 원본 크기: {len(df)}')\n",
    "    print(df.head(3).to_string())\n",
    "    print('label 분포:\\n', df['label'].value_counts().to_string())\n",
    "\n",
    "    df = df.dropna(subset=['document'])\n",
    "    before = len(df)\n",
    "    df = df.drop_duplicates(subset=['document'])\n",
    "    print(f'결측치/중복 제거: {before} -> {len(df)}')\n",
    "    return df\n",
    "\n",
    "\n",
    "def clean_text(text):\n",
    "    \"\"\"리뷰 한 문장에서 한글·영문·숫자·기본 문장부호만 남기고 공백을 정리.\"\"\"\n",
    "    text = str(text)\n",
    "    text = re.sub(r'[^0-9A-Za-z가-힣ㄱ-ㅎㅏ-ㅣ\\s\\?\\!\\.]', ' ', text)  # 한글/영문/숫자/기본 문장부호만 유지\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "\n",
    "def preprocess(df):\n",
    "    \"\"\"정제 후 빈 문장을 걸러내고 (문장 list, 라벨 list) 로 분리.\"\"\"\n",
    "    df = df.copy()\n",
    "    df['clean'] = df['document'].map(clean_text)\n",
    "    df = df[df['clean'].str.len() > 0]\n",
    "    return df['clean'].tolist(), df['label'].astype(int).tolist()\n",
    "\n",
    "\n",
    "train_df = load_corpus(TRAIN_PATH)\n",
    "test_df = load_corpus(TEST_PATH)\n",
    "\n",
    "train_corpus, train_labels = preprocess(train_df)\n",
    "test_corpus, test_labels = preprocess(test_df)\n",
    "\n",
    "print('\\n전처리 후 train:', len(train_corpus), '/ test:', len(test_corpus))\n",
    "print('예시:')\n",
    "for sen in train_corpus[:5]:\n",
    "    print('>>', sen)\n",
    "\n",
    "lengths = [len(s.split()) for s in train_corpus]   # MAXLEN 을 정하기 위한 문장 길이 통계\n",
    "print('\\n공백 기준 어절 수 - 평균 %.1f / 최대 %d' % (sum(lengths) / len(lengths), max(lengths)))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "29854786",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Step 2. SentencePiece 모델 학습\n",
    "\n",
    "`mian.md` 와 동일하게 정제된 corpus를 임시 파일로 쓴 뒤 학습합니다.\n",
    "다만 padding 값 0과 `<unk>`(기본 id 0)이 겹치지 않도록 `--pad_id=0 --unk_id=1` 을 지정했습니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "14df70c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_spm(corpus, model_prefix, vocab_size=8000, model_type='unigram'):\n",
    "    \"\"\"corpus 로 SentencePiece 를 학습하고, 로드까지 끝낸 Processor 를 반환.\"\"\"\n",
    "    temp_file = f'{model_prefix}.temp'\n",
    "\n",
    "    # SentencePiece 는 파일 입력만 받으므로 정제된 corpus 를 한 줄씩 임시 파일로 저장\n",
    "    with open(temp_file, 'w', encoding='utf-8') as f:\n",
    "        for row in corpus:\n",
    "            f.write(str(row) + '\\n')\n",
    "\n",
    "    if not os.path.exists(f'{model_prefix}.model'):   # 이미 학습된 모델이 있으면 재사용\n",
    "        spm.SentencePieceTrainer.Train(\n",
    "            '--input={} --model_prefix={} --vocab_size={} --model_type={} '\n",
    "            '--pad_id=0 --unk_id=1 --bos_id=2 --eos_id=3 '        # 패딩 0 과 <unk> 충돌 방지\n",
    "            '--character_coverage=0.9995'.format(                 # 희귀 문자 0.05% 는 버림\n",
    "                temp_file, model_prefix, vocab_size, model_type)\n",
    "        )\n",
    "    else:\n",
    "        print(f'{model_prefix}.model already exists. Skipping training.')\n",
    "\n",
    "    s = spm.SentencePieceProcessor()\n",
    "    s.Load(f'{model_prefix}.model')\n",
    "    return s\n",
    "\n",
    "\n",
    "sp = train_spm(train_corpus, 'nsmc_spm', vocab_size=8000, model_type='unigram')\n",
    "\n",
    "# .model(토크나이저 본체) 과 .vocab(단어사전) 이 생성되었는지 확인\n",
    "for path in sorted(glob.glob('nsmc_spm*')):\n",
    "    print(f'{path}: {os.path.getsize(path)} bytes')"
   ]
  },
  {
