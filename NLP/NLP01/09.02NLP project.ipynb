  {
   "cell_type": "markdown",
   "id": "1b3a5cce",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Step 3. `sp_tokenize()` 함수 작성\n",
    "\n",
    "- 온전한 문장의 list를 매개변수로 받습니다.\n",
    "- `.vocab` 파일을 읽어 `word_index`, `index_word` 사전을 함께 반환합니다.\n",
    "- 반환하는 `tensor` 는 Encoding + Padding 까지 끝난 텐서입니다. (`lengths` 는 이후 LSTM `pack_padded_sequence` 용)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e56891ef",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sp_tokenize(s, corpus, vocab_file, maxlen=MAXLEN):\n",
    "    \"\"\"문장 list -> (패딩된 id 텐서, 실제 길이, word_index, index_word).\"\"\"\n",
    "    tensor = []\n",
    "\n",
    "    for sen in corpus:\n",
    "        ids = s.EncodeAsIds(sen)[:maxlen]   # maxlen 초과분은 잘라냄\n",
    "        if len(ids) == 0:\n",
    "            ids = [s.unk_id()]              # 빈 문장은 <unk> 하나로 대체 (길이 0 방지)\n",
    "        tensor.append(torch.tensor(ids, dtype=torch.long))\n",
    "\n",
    "    lengths = torch.tensor([len(t) for t in tensor], dtype=torch.long)   # 패딩 전 실제 길이\n",
    "\n",
    "    with open(vocab_file, 'r', encoding='utf-8') as f:\n",
    "        vocab = f.readlines()\n",
    "\n",
    "    word_index = {}\n",
    "    index_word = {}\n",
    "\n",
    "    for idx, line in enumerate(vocab):\n",
    "        word = line.split('\\t')[0]      # \"조각\\t점수\" 형식이므로 앞부분만 사용\n",
    "\n",
    "        word_index.update({word: idx})\n",
    "        index_word.update({idx: word})\n",
    "\n",
    "    # 가장 긴 문장 길이에 맞춰 뒤쪽을 0 으로 채움 -> (문장 수, 최대 길이) 형태\n",
    "    tensor = pad_sequence(tensor, batch_first=True, padding_value=0)\n",
    "\n",
    "    return tensor, lengths, word_index, index_word\n",
    "\n",
    "\n",
    "train_tensor, train_len, word_index, index_word = sp_tokenize(sp, train_corpus, 'nsmc_spm.vocab')\n",
    "test_tensor, test_len, _, _ = sp_tokenize(sp, test_corpus, 'nsmc_spm.vocab')\n",
    "\n",
    "print('train tensor:', train_tensor.shape, '/ test tensor:', test_tensor.shape)\n",
    "print('vocab size:', len(word_index))\n",
    "# index_word 로 첫 문장을 되돌려 사전이 제대로 만들어졌는지 확인 (▁ 는 공백 기호)\n",
    "print('복원 확인:', ''.join(index_word[i] for i in train_tensor[0].tolist() if i != 0).replace('\\u2581', ' ').strip())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a577e0dd",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Step 4. Text Classifier (Bi-LSTM) 정의 및 학습"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f4cabd2d",
   "metadata": {},
   "outputs": [],
   "source": [
    "class SentimentClassifier(nn.Module):\n",
    "    \"\"\"Embedding -> Bi-LSTM -> FC 구조의 긍정/부정 이진 분류기.\"\"\"\n",
    "\n",
    "    def __init__(self, vocab_size, embed_dim=128, hidden_dim=128, num_classes=2):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)   # 0 은 학습 제외\n",
    "        self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True, bidirectional=True)\n",
    "        self.dropout = nn.Dropout(0.3)                          # 과적합 억제\n",
    "        self.fc = nn.Linear(hidden_dim * 2, num_classes)        # *2 : 양방향 출력을 이어붙이므로\n",
    "\n",
    "    def forward(self, x, lengths):\n",
    "        emb = self.dropout(self.embedding(x))\n",
    "        # 패딩 구간을 LSTM 이 계산하지 않도록 실제 길이로 묶어서 전달\n",
    "        packed = pack_padded_sequence(emb, lengths.cpu(), batch_first=True, enforce_sorted=False)\n",
    "        _, (h, _) = self.lstm(packed)\n",
    "        h = torch.cat([h[-2], h[-1]], dim=1)      # 정방향 + 역방향 마지막 hidden state\n",
    "        return self.fc(self.dropout(h))\n",
    "\n",
    "\n",
    "def make_loader(tensor, lengths, labels, shuffle):\n",
    "    \"\"\"(입력 텐서, 길이, 라벨) 을 묶어 미니배치 DataLoader 로 만든다.\"\"\"\n",
    "    dataset = TensorDataset(tensor, lengths, torch.tensor(labels, dtype=torch.long))\n",
    "    return DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=shuffle)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate(model, loader):\n",
    "    \"\"\"주어진 loader 에 대한 평균 loss 와 accuracy 를 계산.\"\"\"\n",
    "    model.eval()\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    total_loss, correct, total = 0.0, 0, 0\n",
    "\n",
    "    for x, lengths, y in loader:\n",
    "        x, lengths, y = x.to(DEVICE), lengths.to(DEVICE), y.to(DEVICE)\n",
    "        logits = model(x, lengths)\n",
    "        total_loss += criterion(logits, y).item() * y.size(0)\n",
    "        correct += (logits.argmax(1) == y).sum().item()\n",
    "        total += y.size(0)\n",
    "\n",
    "    return total_loss / total, correct / total\n",
    "\n",
    "\n",
    "def run_experiment(name, train_tensor, train_len, train_labels,\n",
    "                   test_tensor, test_len, test_labels, vocab_size, epochs=EPOCHS):\n",
    "    \"\"\"토크나이저 하나에 대해 학습 -> 검증 -> 테스트를 수행하고 결과를 dict 로 반환.\"\"\"\n",
    "    print(f'\\n===== {name} =====')\n",
    "\n",
    "    # 학습 데이터의 10% 를 validation 으로 사용\n",
    "    n_val = len(train_labels) // 10\n",
    "    tr_loader = make_loader(train_tensor[n_val:], train_len[n_val:], train_labels[n_val:], shuffle=True)\n",
    "    va_loader = make_loader(train_tensor[:n_val], train_len[:n_val], train_labels[:n_val], shuffle=False)\n",
    "    te_loader = make_loader(test_tensor, test_len, test_labels, shuffle=False)   # 최종 평가용\n",
    "\n",
    "    model = SentimentClassifier(vocab_size).to(DEVICE)\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "    criterion = nn.CrossEntropyLoss()   # 긍정/부정 2클래스 분류\n",
    "\n",
    "    best_state, best_val_acc = None, 0.0\n",
    "\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        model.train()\n",
    "        started = time.time()\n",
    "        running = 0.0\n",
    "\n",
    "        for x, lengths, y in tr_loader:\n",
    "            x, lengths, y = x.to(DEVICE), lengths.to(DEVICE), y.to(DEVICE)\n",
    "            optimizer.zero_grad()\n",
    "            loss = criterion(model(x, lengths), y)\n",
    "            loss.backward()\n",
    "            nn.utils.clip_grad_norm_(model.parameters(), 5.0)   # RNN 기울기 폭주 방지\n",
    "            optimizer.step()\n",
    "            running += loss.item() * y.size(0)\n",
    "\n",
    "        val_loss, val_acc = evaluate(model, va_loader)\n",
    "        print('epoch %d | train_loss %.4f | val_loss %.4f | val_acc %.4f | %.1fs'\n",
    "              % (epoch, running / (len(train_labels) - n_val), val_loss, val_acc, time.time() - started))\n",
    "\n",
    "        if val_acc > best_val_acc:      # val_acc 가 가장 높았던 시점의 가중치를 보관\n",
    "            best_val_acc = val_acc\n",
    "            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n",
    "\n",
    "    model.load_state_dict(best_state)   # 과적합된 마지막 에폭 대신 최적 가중치로 테스트\n",
    "    test_loss, test_acc = evaluate(model, te_loader)\n",
    "    print('>> [%s] test_loss %.4f | test_acc %.4f' % (name, test_loss, test_acc))\n",
    "\n",
    "    return {'name': name, 'val_acc': best_val_acc, 'test_acc': test_acc, 'vocab_size': vocab_size}\n",
    "\n",
    "\n",
    "results = []        # 이후 Step 5 의 비교 실험 결과가 계속 누적된다\n",
    "results.append(run_experiment(\n",
    "    'SentencePiece unigram / vocab 8000',\n",
    "    train_tensor, train_len, train_labels,\n",
    "    test_tensor, test_len, test_labels,\n",
    "    vocab_size=sp.GetPieceSize()))   # Embedding 크기는 실제 토큰 개수와 맞춘다"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "57bdd1c2",
   "metadata": {},
   "source": [
    "> 루브릭 기준인 **test accuracy 80% 이상** 은 이 설정에서 확인됩니다.\n",
    "\n",
    "---\n",
    "\n",
    "## Step 5. 성능 비교\n",
    "\n",
    "### 5-1. SentencePiece 옵션 비교 (`model_type`, `vocab_size`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "995f0d67",
   "metadata": {},
   "outputs": [],
   "source": [
    "spm_configs = [         # (model_type, vocab_size) 조합을 바꿔가며 재학습·재평가\n",
    "    ('bpe', 8000),\n",
    "    ('unigram', 4000),\n",
    "    ('unigram', 16000),\n",
    "]\n",
    "\n",
    "for model_type, vocab_size in spm_configs:\n",
    "    prefix = f'nsmc_spm_{model_type}_{vocab_size}'   # 설정별로 모델 파일을 따로 저장\n",
    "    s = train_spm(train_corpus, prefix, vocab_size=vocab_size, model_type=model_type)\n",
    "\n",
    "    # 토크나이저가 바뀌었으니 학습/테스트 데이터를 다시 인코딩\n",
    "    tr_t, tr_l, _, _ = sp_tokenize(s, train_corpus, f'{prefix}.vocab')\n",
    "    te_t, te_l, _, _ = sp_tokenize(s, test_corpus, f'{prefix}.vocab')\n",
    "\n",
    "    results.append(run_experiment(\n",
