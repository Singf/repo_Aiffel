    "    tr_t, tr_l, _ = tokenize(train_morphs, morph_tokenizer)\n",
    "    te_t, te_l, _ = tokenize(test_morphs, morph_tokenizer)   # 테스트에도 같은 사전을 재사용\n",
    "\n",
