   "cell_type": "code",
   "execution_count": null,
   "id": "3cfd29c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Tokenizer:\n",
    "    \"\"\"mian.md 의 단어 단위 토크나이저: 단어사전을 만들고 문장을 id 로 바꾼다.\"\"\"\n",
    "\n",
    "    def __init__(self, filters=''):\n",
    "        self.word_index = {}\n",
    "        self.index_word = {}\n",
    "        self.filters = filters\n",
    "\n",
    "    def fit_on_texts(self, corpus):\n",
    "        \"\"\"corpus 에 등장한 토큰으로 word_index / index_word 사전을 구축.\"\"\"\n",
    "        for sentence in corpus:\n",
    "            tokens = sentence.split() if isinstance(sentence, str) else sentence\n",
    "            for token in tokens:\n",
    "                if token not in self.word_index:\n",
    "                    self.word_index[token] = len(self.word_index) + 1\n",
    "        self.index_word = {idx: word for word, idx in self.word_index.items()}\n",
    "\n",
    "    def texts_to_sequences(self, corpus):\n",
    "        \"\"\"문장(또는 토큰 list) 을 id 시퀀스로 변환. 사전에 없는 토큰은 0.\"\"\"\n",
    "        sequences = []\n",
    "        for sentence in corpus:\n",
    "            tokens = sentence.split() if isinstance(sentence, str) else sentence\n",
    "            seq = [self.word_index.get(token, 0) for token in tokens][:MAXLEN]\n",
    "            if len(seq) == 0:\n",
    "                seq = [0]\n",
    "            sequences.append(torch.tensor(seq, dtype=torch.long))\n",
    "        return sequences\n",
    "\n",
    "    def sequences_to_texts(self, sequences):\n",
    "        \"\"\"id 시퀀스를 다시 토큰 list 로 복원 (패딩 0 은 제외).\"\"\"\n",
    "        texts = []\n",
    "        for seq in sequences:\n",
    "            if isinstance(seq, torch.Tensor):\n",
    "                seq = seq.tolist()\n",
    "            tokens = [self.index_word.get(idx, '') for idx in seq if idx != 0]\n",
    "            texts.append(tokens)\n",
    "        return texts\n",
    "\n",
    "\n",
    "def tokenize(corpus, tokenizer=None):\n",
    "    \"\"\"mian.md 의 tokenize() 를 응용: 학습 시 만든 tokenizer 를 테스트에 재사용.\"\"\"\n",
    "    if tokenizer is None:\n",
    "        tokenizer = Tokenizer()\n",
    "        tokenizer.fit_on_texts(corpus)\n",
    "    sequences = tokenizer.texts_to_sequences(corpus)\n",
    "    lengths = torch.tensor([len(s) for s in sequences], dtype=torch.long)\n",
    "    tensor = pad_sequence(sequences, batch_first=True, padding_value=0)\n",
    "    return tensor, lengths, tokenizer"
   ]
