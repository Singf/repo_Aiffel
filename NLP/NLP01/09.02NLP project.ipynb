    "def get_mecab():\n",
    "    \"\"\"Windows(C:\\\\mecab, mecab-ko-msvc) 환경용 KoNLPy Mecab 래퍼.\"\"\"\n",
    "    MECAB_HOME = r'C:\\mecab'\n",
    "    os.environ['PATH'] = MECAB_HOME + r'\\bin;' + os.environ.get('PATH', '')   # DLL 탐색 경로 추가\n",
    "\n",
    "    from konlpy.tag import Mecab\n",
    "    from MeCab import Tagger\n",
    "    from konlpy import utils\n",
    "\n",
    "    class WindowsMecab(Mecab):\n",
    "        def __init__(self, dicpath=r'C:/mecab/share/mecab-ko-dic'):\n",
    "            self.dicpath = dicpath\n",
    "            self.tagger = Tagger(f'-r C:/mecab/etc/mecabrc -d {dicpath}')\n",
    "            self.tagset = utils.read_json(f'{utils.installpath}/data/tagset/mecab.json')\n",
    "\n",
    "    return WindowsMecab()\n",
    "\n",
    "\n",
    "def build_morph_vocab(tokenized_corpus, max_vocab=8000):\n",
    "    \"\"\"형태소 빈도 상위 max_vocab 개만 담은 Tokenizer 를 만든다 (SentencePiece 와 조건 통일).\"\"\"\n",
    "    from collections import Counter\n",
    "\n",
    "    counter = Counter(tok for tokens in tokenized_corpus for tok in tokens)\n",
    "    tokenizer = Tokenizer()\n",
    "    for word, _ in counter.most_common(max_vocab - 1):       # 0번은 padding/unk 용\n",
    "        tokenizer.word_index[word] = len(tokenizer.word_index) + 1\n",
    "    tokenizer.index_word = {idx: w for w, idx in tokenizer.word_index.items()}\n",
    "    return tokenizer\n",
    "\n",
    "\n",
    "try:\n",
    "    mecab = get_mecab()\n",
    "    print(mecab.morphs('자연어처리가너무재밌어서밥먹는것도가끔까먹어요'))   # 형태소 분석 동작 확인\n",
    "\n",
    "    train_morphs = [mecab.morphs(s) for s in train_corpus]   # 문장 -> 형태소 list\n",
